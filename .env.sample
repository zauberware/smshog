# Keep messages across restarts (app default: false). docker-compose.yml mounts ./data to /data.
SMSHOG_PERSIST=true
SMSHOG_PERSIST_PATH=/data/sms-store.json
# Optional: keep only the newest N messages (default: unlimited)
# SMSHOG_MAX_MESSAGES=1000

# production port
PORT=8080 # nginx will forward to backend/frontend
# development ports for backend and frontend 
# backend port
BACKEND_PORT=3000
# frontend port
FRONTEND_PORT=3001
