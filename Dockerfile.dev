# Shared base: the whole workspace installed from the lockfile
FROM node:26-alpine AS base

WORKDIR /app

# curl is used by the compose health check; the node image no longer ships yarn
RUN apk add --no-cache curl && npm install -g yarn@1.22.22

COPY package.json yarn.lock ./
COPY backend/package.json backend/
COPY frontend/package.json frontend/

RUN yarn install --frozen-lockfile

# Source files are mounted as volumes by docker-compose.dev.yml

# Backend development stage
FROM base AS backend-dev

WORKDIR /app/backend

EXPOSE 3000

CMD ["yarn", "dev"]

# Frontend development stage
FROM base AS frontend-dev

WORKDIR /app/frontend

EXPOSE 8080

# Run the Vite dev server on all interfaces
CMD ["yarn", "dev", "--host", "0.0.0.0"]
